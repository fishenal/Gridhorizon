# Copy to .env.local for local development

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional absolute URL; trustHost is enabled so Preview works without this
# AUTH_URL=http://localhost:3000

# Travel speed: 3 for testing, 60 for production (~1 min/tile)
TRAVEL_SECONDS_PER_TILE=3

# Shared world seed (same seed => same map)
WORLD_SEED=424242

# Protects /api/cron/tick (Production cron only)
CRON_SECRET=
