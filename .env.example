# Copy to .env.local for local development

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=yZyAAKqAh8dEY7NFS+DEd2t7soT+omHe03jZXt7zVLw=

# Optional absolute URL; trustHost is enabled so Preview works without this
# AUTH_URL=http://localhost:3000

# Travel speed: 1 for current build; 60 for production (~1 min/tile)
TRAVEL_SECONDS_PER_TILE=1

# Shared world seed (same seed => same map)
WORLD_SEED=424242

# Soft gate before login/play (not for public launch)
ACCESS_CODE=fishenal

# Protects /api/cron/tick (Production cron only)
CRON_SECRET=
